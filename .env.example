# Copier ce fichier en .env et adapter les valeurs.

# Comment Friday s'adresse à toi
FRIDAY_USER_NAME=Monsieur

# Cerveau local (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Taille du contexte (mémoire de travail du modèle, en tokens). 16384 tient sur une carte de
# 8 Go si Ollama compresse cette mémoire : variables Windows OLLAMA_FLASH_ATTENTION=1 et
# OLLAMA_KV_CACHE_TYPE=q8_0 (puis redémarrer Ollama). Sinon, 8192.
OLLAMA_NUM_CTX=8192

# Claude Code, pour les tâches de code / complexes (sonnet, opus, haiku...)
CLAUDE_MODEL=sonnet
# Délégation à Claude Code (CLI « claude », compte Pro, sans clé API). Friday demande toujours
# confirmation avant de lancer une tâche (elle consomme le quota de l'abonnement).
CLAUDE_ENABLED=true
# Dossier où Claude peut créer et modifier des fichiers (vide = Documents/Dev/Friday-Workspace)
CLAUDE_WORKSPACE=
# Durée maximale d'une tâche, en secondes
CLAUDE_TIMEOUT=900

# Voix de Friday (Piper, 100 % local)
TTS_ENABLED=true
# Voix : fr_FR-siwis-medium, fr_FR-tom-medium, fr_FR-upmc-medium, fr_FR-gilles-low (lent : TTS_SPEED=1.5)
# Comparer les voix : uv run python -m jarvis.voice.audition
TTS_VOICE=fr_FR-siwis-medium
# Pour les voix à plusieurs locuteurs (upmc : 0 = Jessica, 1 = Pierre)
TTS_SPEAKER=
# Vitesse de parole (1.0 = normale, 1.2 = plus rapide)
TTS_SPEED=1.0
# Comment la voix (française) doit dire le nom, pour une prononciation à l'anglaise
TTS_NAME_PRONUNCIATION=Fraille dé

# Écoute (faster-whisper, 100 % local)
STT_ENABLED=true
# Modèle : large-v3-turbo (précis), small (plus léger si la mémoire vidéo manque)
STT_MODEL=large-v3-turbo
# cuda (carte graphique) ou cpu
STT_DEVICE=cuda
# Micro : vide = micro par défaut de Windows, sinon numéro ou morceau du nom
# Lister les micros : uv run python -m sounddevice
MIC_DEVICE=
# Sortie audio de Friday : vide = sortie par défaut de Windows, sinon numéro ou morceau du nom
# (ex. contourner un mixeur virtuel comme SteelSeries Sonar)
OUTPUT_DEVICE=
# Touche à maintenir pour parler (home, f9, right ctrl, page up...)
PTT_KEY=home

# Mains libres : dire « Friday, ... » sans toucher au clavier
HANDS_FREE=true
# Mots qui réveillent Friday (le 1er est son nom ; ajouter des variantes si Whisper l'écrit autrement)
WAKE_WORDS=friday
# Langue du nom : s'il manque au début d'une phrase, ce début est retranscrit dans cette langue
# (« Friday » se dit à l'anglaise : en). fr = pas de seconde transcription
WAKE_LANGUAGE=en
# Après une réponse, secondes pendant lesquelles on peut relancer sans redire « Friday » (0 = jamais)
FOLLOW_UP_SECONDS=8
# Silence (ms) qui marque la fin d'une phrase : plus court = plus réactif, mais risque de couper
VAD_SILENCE_MS=700
# Diagnostic : garde les 100 dernières phrases entendues (logs/heard/, .wav + texte compris)
HANDS_FREE_RECORD=false

# Outils (recherche web, images, lecture de pages)
TOOLS_ENABLED=true
# Région de recherche DuckDuckGo (fr-fr, be-fr, ch-fr, ca-fr...)
SEARCH_REGION=fr-fr
# Moteurs de recherche : auto (essaie plusieurs moteurs), ou une liste ordonnée,
# ex. yahoo,startpage,duckduckgo,brave (moteurs disponibles : brave, duckduckgo, google,
# mojeek, startpage, wikipedia, yahoo)
SEARCH_BACKEND=auto
# Ville par défaut pour la météo (sinon Friday utilise celle qu'il a mémorisée)
HOME_CITY=
# Contrôle du PC : ouvrir/fermer des applis (fermer demande confirmation), sites, volume, musique
PC_CONTROL=true
# Fichiers et presse-papier : lire un PDF / Word / texte (ou glissé dans la fenêtre), lire ce
# qui est copié, copier un texte corrigé, chercher et ouvrir des fichiers (Documents, Bureau,
# Téléchargements, Images)
FILES_ACCESS=true
# Voir l'écran : « regarde mon écran », « c'est quoi cette erreur ? ». Modèle de vision local
# (la capture ne quitte pas le PC) : ollama pull qwen3-vl:4b-instruct. Prend la place de qwen3
# quelques secondes (8 Go de mémoire vidéo ne suffisent pas pour les deux). En secours, Friday
# peut demander à Claude (avec confirmation : la capture part alors en ligne).
VISION_ENABLED=true
VISION_MODEL=qwen3-vl:4b-instruct
# Agenda et mails Google : nécessite data/google_credentials.json (client OAuth « application de
# bureau » d'un projet Google Cloud, voir README). Au premier lancement, le navigateur s'ouvre
# pour autoriser Friday. Envoi de mail et suppression d'événement : toujours avec confirmation.
GOOGLE_ENABLED=true
# Minuteurs, rappels, notes et listes (data/agenda.db, 100 % local)
AGENDA_ENABLED=true

# Mémoire long terme (data/memory.db, 100 % local)
MEMORY_ENABLED=true
# Mémoriser automatiquement ce qui compte dans les conversations (sinon : seulement sur demande)
MEMORY_AUTO=true
# Modèle d'embeddings Ollama (multilingue) : ollama pull embeddinggemma
EMBED_MODEL=embeddinggemma

# Bibliothèque : PDF, livres, cours et notes déposés dans data/bibliotheque, indexés en local
# (recherche par le sens et par les mots). Demande la mémoire (même modèle d'embeddings).
LIBRARY_ENABLED=true

# Mode trading (« mode trading » / « fin du mode trading ») : analyses par Claude Code ISOLÉ
# (aucun outil, ni web, ni fichiers du PC), toujours après un aperçu à valider ; calculs de
# risque et journal (data/trading.db) restent locaux. Demande CLAUDE_ENABLED.
TRADING_ENABLED=true
TRADING_ACCOUNT_CURRENCY=EUR
# Extraits de la bibliothèque joints à une analyse (1 à 15) et taille maximale d'un envoi
TRADING_PASSAGES=10
TRADING_MAX_CHARS=12000
# Mots toujours masqués avant envoi (nom, numéro de client…), séparés par des virgules
TRADING_BLOCKLIST=
# Modèle Claude pour les analyses (vide : CLAUDE_MODEL)
TRADING_MODEL=

# Couleur de l'interface et de l'hologramme : Or, Cyan, Violet, Vert, Rouge, Blanc ou #rrggbb.
# Couleur de départ seulement : celle choisie dans l'application (bouton palette) est gardée.
FRIDAY_COLOR=Or

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
