# Copier ce fichier en .env et adapter les valeurs.

# Comment Jarvis s'adresse à toi
JARVIS_USER_NAME=Monsieur

# Cerveau local (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Taille du contexte (mémoire de travail du modèle, en tokens)
OLLAMA_NUM_CTX=8192

# Claude Code, pour les tâches de code / complexes (sonnet, opus, haiku...)
CLAUDE_MODEL=sonnet
# Délégation à Claude Code (CLI « claude », compte Pro, sans clé API). Jarvis demande toujours
# confirmation avant de lancer une tâche (elle consomme le quota de l'abonnement).
CLAUDE_ENABLED=true
# Dossier où Claude peut créer et modifier des fichiers (vide = Documents/Dev/Jarvis-Workspace)
CLAUDE_WORKSPACE=
# Durée maximale d'une tâche, en secondes
CLAUDE_TIMEOUT=900

# Voix de Jarvis (Piper, 100 % local)
TTS_ENABLED=true
# Voix : fr_FR-siwis-medium, fr_FR-tom-medium, fr_FR-upmc-medium, fr_FR-gilles-low (lent : TTS_SPEED=1.5)
# Comparer les voix : uv run python -m jarvis.voice.audition
TTS_VOICE=fr_FR-siwis-medium
# Pour les voix à plusieurs locuteurs (upmc : 0 = Jessica, 1 = Pierre)
TTS_SPEAKER=
# Vitesse de parole (1.0 = normale, 1.2 = plus rapide)
TTS_SPEED=1.0

# Écoute (faster-whisper, 100 % local)
STT_ENABLED=true
# Modèle : large-v3-turbo (précis), small (plus léger si la mémoire vidéo manque)
STT_MODEL=large-v3-turbo
# cuda (carte graphique) ou cpu
STT_DEVICE=cuda
# Micro : vide = micro par défaut de Windows, sinon numéro ou morceau du nom
# Lister les micros : uv run python -m sounddevice
MIC_DEVICE=
# Sortie audio de Jarvis : vide = sortie par défaut de Windows, sinon numéro ou morceau du nom
# (ex. contourner un mixeur virtuel comme SteelSeries Sonar)
OUTPUT_DEVICE=
# Touche à maintenir pour parler (home, f9, right ctrl, page up...)
PTT_KEY=home

# Mains libres : dire « Jarvis, ... » sans toucher au clavier
HANDS_FREE=true
# Mots qui réveillent Jarvis (le 1er est affiché ; les autres couvrent les erreurs de Whisper)
WAKE_WORDS=jarvis,jarvie,djarvis,jarvice,jarvi
# Après une réponse, secondes pendant lesquelles on peut relancer sans redire « Jarvis » (0 = jamais)
FOLLOW_UP_SECONDS=8
# Silence (ms) qui marque la fin d'une phrase : plus court = plus réactif, mais risque de couper
VAD_SILENCE_MS=700

# Outils (recherche web, images, lecture de pages)
TOOLS_ENABLED=true
# Région de recherche DuckDuckGo (fr-fr, be-fr, ch-fr, ca-fr...)
SEARCH_REGION=fr-fr
# Moteurs de recherche : auto (essaie plusieurs moteurs), ou une liste ordonnée,
# ex. yahoo,startpage,duckduckgo,brave (moteurs disponibles : brave, duckduckgo, google,
# mojeek, startpage, wikipedia, yahoo)
SEARCH_BACKEND=auto
# Ville par défaut pour la météo (sinon Jarvis utilise celle qu'il a mémorisée)
HOME_CITY=
# Contrôle du PC : ouvrir/fermer des applis (fermer demande confirmation), sites, volume, musique
PC_CONTROL=true
# Minuteurs, rappels, notes et listes (data/agenda.db, 100 % local)
AGENDA_ENABLED=true

# Mémoire long terme (data/memory.db, 100 % local)
MEMORY_ENABLED=true
# Mémoriser automatiquement ce qui compte dans les conversations (sinon : seulement sur demande)
MEMORY_AUTO=true
# Modèle d'embeddings Ollama (multilingue) : ollama pull embeddinggemma
EMBED_MODEL=embeddinggemma

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
